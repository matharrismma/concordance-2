#!/bin/sh
# Reads each engine's /health from outside. A frozen process fails nothing and restarts nothing by itself, so this does.
# Each unit keeps its own count and its own grace from its own start, and restarts only itself. A restart that fails
# fails the run, once the other unit has been read too.
LIMIT="${NH_WATCH_LIMIT:-4}"
GRACE="${NH_WATCH_GRACE:-180}"
FAILED=0
read_unit() {
  UNIT=$1 URL=$2 STATE=$3
  if [ "$(systemctl is-active "$UNIT")" != "active" ]; then rm -f "$STATE"; return 0; fi
  started=$(systemctl show "$UNIT" -p ActiveEnterTimestampMonotonic --value)
  now=$(awk '{printf "%d", $1 * 1000000}' /proc/uptime)
  if [ -z "${NH_WATCH_NOGRACE:-}" ] && [ $(( (now - started) / 1000000 )) -lt "$GRACE" ]; then rm -f "$STATE"; return 0; fi
  if curl -fsS -m 10 "$URL" >/dev/null 2>&1; then rm -f "$STATE"; return 0; fi
  n=$(( $(cat "$STATE" 2>/dev/null || echo 0) + 1 ))
  echo "$n" > "$STATE"
  logger -t nh-engine-watch "$UNIT health read failed, $n of $LIMIT"
  if [ "$n" -ge "$LIMIT" ]; then
    rm -f "$STATE"
    logger -t nh-engine-watch "restarting $UNIT after $n failed reads"
    if [ -n "${NH_WATCH_DRY:-}" ]; then echo "DRY: would restart $UNIT"; else systemctl restart "$UNIT" || FAILED=1; fi
  fi
}
read_unit nh-engine "${NH_WATCH_URL:-http://127.0.0.1:8002/health}" "${NH_WATCH_STATE:-/run/nh-engine-watch.fails}"
read_unit nh-mcp "${NH_WATCH_MCP_URL:-http://127.0.0.1:8003/health}" "${NH_WATCH_MCP_STATE:-/run/nh-mcp-watch.fails}"
exit "$FAILED"
