# THE DEDICATED MCP HOST (2026-10-16 — Matt: "set up a dedicated MCP host").
# A SECOND engine process whose only job is the agents' door: /mcp. Decoupled from nh-engine, so a site
# deploy/restart never interrupts an agent mid-call, and an MCP spike never touches the site. Same code,
# the same READ-ONLY corpus (~1.2 GB; the box has headroom — ~5.7 GB free measured 2026-10-16). Caddy routes
# /mcp -> :8003 (api.narrowhighway.com today; mcp.narrowhighway.com once its DNS A record points at the box).
# tools/deploy.sh restarts it alongside nh-engine so both stay on the same code.
# Rollback: route /mcp back to :8002 in /etc/caddy/Caddyfile (+ reload caddy), then `sudo systemctl disable --now nh-mcp`.
[Unit]
Description=Narrow Highway — the dedicated MCP host (the agents' door, /mcp, decoupled from the site engine)
After=network.target

[Service]
User=nh
WorkingDirectory=/home/nh/concordance-2
EnvironmentFile=-/home/nh/concordance-2/.env
Environment=PYTHONPATH=/home/nh/concordance-2/src
Environment=CONCORDANCE_DATA_DIR=/home/nh/concordance-2/data
Environment=CONCORDANCE_STRONGS_DIR=/home/nh/concordance-2/data/strongs
ExecStart=/home/nh/concordance-2/.venv/bin/python -m concordance serve --host 127.0.0.1 --surface secular --port 8003
LimitNOFILE=65536
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
