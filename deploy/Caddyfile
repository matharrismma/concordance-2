# Narrow Highway — Caddy reverse proxy (auto-TLS via Let's Encrypt).
#
#
#
# CURRENT LIVE REALITY (2026-07-02): 1.0 (nh-engine :8000) is RETIRED — everything is 2.0.
#   narrowhighway.com      -> :8002  (2.0 secular; front door, app, engine, seals, card permalinks)
#   api.narrowhighway.com  -> :8002  (2.0 secular; verify/derivation.verify/search/seal/mcp/identity)
#   narrowhighway.org      -> :8001  (2.0 witness)
#   narrowhighway.tv       -> :8002  (2.0 secular; the TV GUIDE at /tv — watch/listen/learn)

api.narrowhighway.com {
	encode gzip zstd
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	route {
		# /mcp -> the DEDICATED MCP host (nh-mcp :8003), decoupled from the site engine (applied live 2026-10-16)
		reverse_proxy /mcp* 127.0.0.1:8003 {
			lb_try_duration 10s
			lb_try_interval 250ms
		}
		reverse_proxy 127.0.0.1:8002 {
			lb_try_duration 10s
			lb_try_interval 250ms
		}
	}
	log {
		output file /var/log/caddy/api.access.log
		format json
	}
}

narrowhighway.com {
	encode gzip zstd
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	@legacy path /almanac.html /apothecary.html /walk.html /kept.html /enter.html /packets.html /breath.html /missions.html /search.html /voices
	route {
		# Retired 1.0 lifestyle pages -> home (content archived) so cited links don't hard-404.
		redir @legacy / 301
		# Retired 1.0 pages -> their nearest 2.0 home.
		redir /about.html /guarantees.html 301
		redir /today.html /journal.html 301
		redir /curriculum.html /read.html 301
		redir /submit-curriculum.html /read.html 301
		redir /guidance.html /ask.html 301
		redir /canon.html /bible.html 301
		redir /bibles.html /bible.html 301
		redir /bible-trivia.html /bible.html 301
		redir /reach.html /community.html 301
		redir /outreach.html /community.html 301
		redir /assembly.html /community.html 301
		redir /media-center.html https://narrowhighway.tv/ 301
		# Releases (2026-10-03): the field pack and the Kiwix ZIM, each with its sha256 — served as files from
		# /srv/nh-releases (cut by nh-zim.timer / tools/cut_field_pack.py). A known branch: one place, one hash.
		redir /releases /releases/ 301
		handle_path /releases/* {
			root * /srv/nh-releases
			file_server
		}
		reverse_proxy 127.0.0.1:8002 {
			lb_try_duration 10s
			lb_try_interval 250ms
		}
	}
	log {
		output file /var/log/caddy/site.access.log
		format json
	}
}

narrowhighway.org {
	encode gzip zstd
	route {
		# V3 (2026-10-21): .org is served by the witness app (matharrismma/witness, nh-org.service
		# on :8010), which calls this core over HTTP. Rollback to the core's own witness surface is
		# :8001 (still running). Snapshot of the box's /etc/caddy/Caddyfile; never deployed from here.
		reverse_proxy 127.0.0.1:8010 {
			lb_try_duration 10s
			lb_try_interval 250ms
		}
	}
	# The witness MUST be measured too — without this block .org logging froze (org.access.log stale
	# since 2026-08-29) and the Bridge could never show .org traffic. Matches site/tv's json log so
	# tools/traffic_rollup.py (glob /var/log/caddy/*.access.log) rolls it into data/traffic.json.
	log {
		output file /var/log/caddy/org.access.log
		format json
	}
}

narrowhighway.tv {
	encode gzip zstd
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	@root path /
	route {
		# The bare domain -> the CLEAN /tv (not /tv.html, which 301s back and would loop).
		rewrite @root /tv
		reverse_proxy 127.0.0.1:8002 {
			lb_try_duration 10s
			lb_try_interval 250ms
		}
	}
	log {
		output file /var/log/caddy/tv.access.log
		format json
	}
}
