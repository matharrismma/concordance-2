# ONE ENGINE, BOTH FACES (2026-10-08 — Matt: "one corpus for both surfaces").
# One process serves the witness (.org, :8001) and the secular (.com/.tv/api, :8002) from ONE corpus, one
# graph, one set of verify deps, one launch roll-call. Before this: two units, two corpora of ~1.1 GB each,
# the idle witness copy paged to swap (MemoryCurrent nh-org 328 MB vs nh-com-2 2,039 MB measured 2026-10-08).
# Caddy's upstreams are unchanged. The trade: one failure domain — a crash takes both faces down together;
# tools/deploy.sh's gate + auto-revert remain and it polls both ports. Rollback:
#   sudo systemctl disable --now nh-engine && sudo systemctl enable --now nh-org nh-com-2
[Unit]
Description=Narrow Highway — one engine, both faces (.org witness :8001 + .com secular :8002, one corpus)
After=network.target

[Service]
User=nh
WorkingDirectory=/home/nh/concordance-2
EnvironmentFile=-/home/nh/concordance-2/.env
Environment=PYTHONPATH=/home/nh/concordance-2/src
Environment=CONCORDANCE_DATA_DIR=/home/nh/concordance-2/data
Environment=CONCORDANCE_STRONGS_DIR=/home/nh/concordance-2/data/strongs
ExecStart=/home/nh/concordance-2/.venv/bin/python -m concordance serve --host 127.0.0.1 --surface both --witness-port 8001 --secular-port 8002
LimitNOFILE=65536
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
